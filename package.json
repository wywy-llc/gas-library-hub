{
  "name": "gas-library-hub",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run paraglide:compile && vite dev",
    "build": "npm run paraglide:compile && vite build",
    "build:production": "npm run paraglide:compile && vite build && npm run db:migrate",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "fix": "prettier --write --log-level silent . && eslint --fix .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest --run",
    "test:unit": "vitest",
    "test:e2e": "node test/scripts/run-e2e-tests.js",
    "test:e2e:setup": "node test/scripts/setup-test-db.js",
    "test:e2e:cleanup": "node test/scripts/cleanup-test-db.js",
    "test:storybook": "vitest --project storybook --run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "story": "storybook dev -p 6006 --no-open",
    "story:build": "storybook build",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5",
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-a11y": "^10.2.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/addon-svelte-csf": "^5.0.10",
    "@storybook/addon-vitest": "^10.2.0",
    "@storybook/sveltekit": "^10.2.0",
    "@sveltejs/adapter-vercel": "^6.3.1",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "daisyui": "^5.5.14",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.2.0",
    "eslint-plugin-svelte": "^3.14.0",
    "factory.ts": "^1.4.2",
    "globals": "^17.1.0",
    "jsdom": "^27.4.0",
    "mdsvex": "^0.12.6",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.2.0",
    "svelte": "^5.48.1",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@auth/core": "^0.40.0",
    "@auth/sveltekit": "^1.11.1",
    "@inlang/paraglide-js": "^2.9.1",
    "@neondatabase/serverless": "^1.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@types/pg": "^8.16.0",
    "@vercel/postgres": "^0.10.0",
    "dompurify": "^3.3.1",
    "drizzle-orm": "^0.45.1",
    "github-markdown-css": "^5.8.1",
    "google-auth-library": "^10.5.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "nanoid": "^5.1.6",
    "openai": "^6.16.0",
    "pg": "^8.17.2"
  },
  "lint-staged": {
    "*.{js,ts,svelte,json,md}": [
      "prettier --write"
    ]
  }
}
