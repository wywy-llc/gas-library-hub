{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/dev.sh fix"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/dev.sh check"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Bash(rm -rf:*)", "Read(.env*)", "Edit(.env*)", "Write(.env*)", "MultiEdit(.env*)"]
  }
}
